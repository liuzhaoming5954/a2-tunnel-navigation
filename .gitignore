# Explicitly reviewed, small synthetic fixtures may be versioned
!tests/fixtures/**/*.db
!tests/fixtures/**/*.db3
!tests/fixtures/**/*.sqlite
!tests/fixtures/**/*.sqlite3
!tests/fixtures/**/*.pcd
!tests/fixtures/**/*.ply

