[Unit]
Description=A2 PC2 独立方向键证据
After=network.target

[Service]
# 发布器拥有快照，发令账号仅能通过组权限读取，浏览器不接触快照或通道密钥。
User=root
Group=a2-autonomy
RuntimeDirectory=a2-keyboard-hold
RuntimeDirectoryMode=0750
UMask=0027
ExecStart=/usr/bin/python3 -sB /usr/local/libexec/a2-keyboard-hold-pc2 pc2
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
